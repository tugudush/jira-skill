{
  "name": "jira-cloud-skill",
  "version": "0.1.1",
  "private": true,
  "description": "Read-only Jira Cloud CLI for an agent skill (no dependencies; only HTTP GET is ever sent)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
